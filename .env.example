# Optional local-only admin API used by server.mjs.
# Copy this file to .env and replace both values. If ADMIN_PASSWORD is absent,
# shorter than 16 characters, or left at the placeholder, local writes stay disabled.
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Use at least 32 random characters. If omitted, sessions are invalidated whenever
# the local server restarts because a temporary in-memory secret is generated.
SESSION_SECRET=replace-with-a-long-random-secret
